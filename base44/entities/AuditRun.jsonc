{
  "name": "AuditRun",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "complete",
        "error"
      ]
    },
    "total_chapters": {
      "type": "number"
    },
    "processed_chapters": {
      "type": "number"
    },
    "total_words": {
      "type": "number"
    },
    "avg_omega": {
      "type": "number"
    },
    "total_bugs": {
      "type": "number"
    },
    "critical_count": {
      "type": "number"
    },
    "high_count": {
      "type": "number"
    },
    "medium_count": {
      "type": "number"
    },
    "error_message": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "status"
  ]
}