{
  "description": "Hybrid retrieval — BM25 keyword + dense-vector semantic, with RRF fusion. Replace QUERY_VECTOR with a real embedding generated by the same model used at ingestion (text-embedding-3-small by default).",
  "endpoint": "GET /ramos-manuscript/_search",
  "body": {
    "size": 20,
    "_source": {
      "excludes": ["embedding"]
    },
    "retriever": {
      "rrf": {
        "retrievers": [
          {
            "standard": {
              "query": {
                "bool": {
                  "should": [
                    {
                      "multi_match": {
                        "query": "REPLACE_WITH_QUERY_STRING",
                        "fields": ["text^1.5", "text.shingles^2.0", "chapter_title"],
                        "type": "best_fields"
                      }
                    },
                    {
                      "match_phrase": {
                        "text.original_case": {
                          "query": "REPLACE_WITH_QUERY_STRING",
                          "boost": 2.5
                        }
                      }
                    }
                  ],
                  "filter": [
                    { "term": { "doc_type": "paragraph" } }
                  ]
                }
              }
            }
          },
          {
            "knn": {
              "field": "embedding",
              "query_vector": "REPLACE_WITH_QUERY_VECTOR",
              "k": 50,
              "num_candidates": 200,
              "filter": [
                { "term": { "doc_type": "paragraph" } }
              ]
            }
          }
        ],
        "rank_window_size": 100,
        "rank_constant": 60
      }
    },
    "highlight": {
      "fields": {
        "text": { "fragment_size": 220, "number_of_fragments": 2 }
      }
    },
    "aggs": {
      "by_chapter": {
        "terms": { "field": "chapter_num", "size": 50, "order": { "_key": "asc" } }
      },
      "by_act": {
        "terms": { "field": "act", "size": 5 }
      },
      "avg_dialogue_pct": {
        "avg": { "field": "dialogue_pct" }
      },
      "avg_spanish_token_pct": {
        "avg": { "field": "spanish_token_pct" }
      },
      "behavioral_distribution": {
        "stats": { "field": "behavioral_vectors.agency" }
      }
    }
  }
}
