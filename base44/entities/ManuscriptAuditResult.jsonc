{
  "name": "ManuscriptAuditResult",
  "type": "object",
  "properties": {
    "audit_run_id": {
      "type": "string",
      "description": "Unique ID for this audit run (timestamp-based)"
    },
    "chapter_number": {
      "type": "number",
      "description": "Chapter number (1-44)"
    },
    "chapter_title": {
      "type": "string"
    },
    "act": {
      "type": "string",
      "enum": [
        "I",
        "II",
        "III"
      ]
    },
    "word_count": {
      "type": "number"
    },
    "omega_score": {
      "type": "number"
    },
    "cls_score": {
      "type": "number",
      "description": "Cultural Language Score"
    },
    "bis_score": {
      "type": "number",
      "description": "Behavioral Integrity Score"
    },
    "sii_score": {
      "type": "number",
      "description": "Sensory Immersion Index"
    },
    "mrf_score": {
      "type": "number",
      "description": "Multi-Register Frequency"
    },
    "dialogue_pct": {
      "type": "number",
      "description": "Percentage of dialogue vs prose"
    },
    "sensory_density": {
      "type": "number",
      "description": "Sensory references per 1000 words"
    },
    "pov_violations": {
      "type": "number"
    },
    "continuity_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of continuity issues found"
    },
    "anachronisms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice_drift_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "character_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "structural_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agency_score": {
      "type": "number",
      "description": "1-5 protagonist agency score"
    },
    "overall_severity": {
      "type": "string",
      "enum": [
        "CLEAN",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "summary": {
      "type": "string",
      "description": "2-3 sentence editorial summary"
    },
    "priority_fix": {
      "type": "string",
      "description": "Single most urgent fix needed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "complete",
        "error"
      ]
    }
  },
  "required": [
    "audit_run_id",
    "chapter_number",
    "status"
  ]
}