{
  // ManuscriptAuditResult.jsonc (Updated for v13)
  // Individual audit findings with required evidence_quotes[], severity rubric, and known defect tracking
  "entity_name": "ManuscriptAuditResult",
  "table_name": "manuscript_audit_results",
  "description": "Individual audit findings with verbatim evidence quotes and severity classification",
  "fields": [
    {
      "name": "result_id",
      "type": "UUID",
      "primary_key": true,
      "description": "Unique identifier for this audit finding"
    },
    {
      "name": "audit_run_id",
      "type": "UUID",
      "foreign_key": true,
      "references": "audit_runs",
      "description": "Parent audit run"
    },
    {
      "name": "chapter_id",
      "type": "INTEGER",
      "nullable": true,
      "description": "Chapter number if finding is chapter-specific (1-45)"
    },
    {
      "name": "section",
      "type": "VARCHAR(255)",
      "nullable": true,
      "description": "Section or subsection identifier"
    },
    {
      "name": "finding_type",
      "type": "ENUM",
      "enum_values": ["clarity", "evidence", "rigor", "consistency", "completeness", "citation", "structure", "other"],
      "description": "Category of finding"
    },
    {
      "name": "title",
      "type": "VARCHAR(255)",
      "description": "Brief title of the finding"
    },
    {
      "name": "description",
      "type": "TEXT",
      "description": "Detailed description of the issue"
    },
    {
      "name": "evidence_quotes",
      "type": "JSONB",
      "description": "Array of verbatim quotes from manuscript: { quotes: [ { quote_text, line_number, context } ] }"
    },
    {
      "name": "severity",
      "type": "INTEGER",
      "description": "Severity rubric (1-10 scale: 1=negligible to 10=terminal)"
    },
    {
      "name": "severity_label",
      "type": "VARCHAR(50)",
      "description": "Severity label (negligible, minimal, minor, light, moderate, significant, major, critical, severe, terminal)"
    },
    {
      "name": "is_known_defect",
      "type": "BOOLEAN",
      "default": false,
      "description": "Is this a known/pre-computed defect from defect ledger?"
    },
    {
      "name": "known_defect_id",
      "type": "VARCHAR(100)",
      "nullable": true,
      "description": "Reference to known defect in ledger"
    },
    {
      "name": "remediation_suggestion",
      "type": "TEXT",
      "nullable": true,
      "description": "Suggested fix or remediation"
    },
    {
      "name": "remediation_task_id",
      "type": "UUID",
      "foreign_key": true,
      "references": "remediation_tasks",
      "nullable": true,
      "description": "Associated remediation task if created"
    },
    {
      "name": "status",
      "type": "ENUM",
      "enum_values": ["open", "assigned", "in_revision", "resolved", "acknowledged", "wont_fix"],
      "default": "open",
      "description": "Current status of this finding"
    },
    {
      "name": "priority",
      "type": "ENUM",
      "enum_values": ["critical", "high", "medium", "low"],
      "description": "Priority for remediation"
    },
    {
      "name": "assigned_to",
      "type": "VARCHAR(255)",
      "nullable": true,
      "description": "Assigned reviewer or author"
    },
    {
      "name": "metadata",
      "type": "JSONB",
      "nullable": true,
      "description": "Additional finding metadata"
    },
    {
      "name": "created_at",
      "type": "TIMESTAMP",
      "default": "CURRENT_TIMESTAMP",
      "description": "Record creation timestamp"
    }
  ],
  "indexes": [
    {
      "name": "idx_audit_results_audit_run",
      "columns": ["audit_run_id"],
      "unique": false
    },
    {
      "name": "idx_audit_results_chapter",
      "columns": ["chapter_id"],
      "unique": false
    },
    {
      "name": "idx_audit_results_severity",
      "columns": ["severity"],
      "unique": false
    },
    {
      "name": "idx_audit_results_status",
      "columns": ["status"],
      "unique": false
    },
    {
      "name": "idx_audit_results_known_defect",
      "columns": ["is_known_defect"],
      "unique": false
    }
  ]
}
